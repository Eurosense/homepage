{
  "name": "eurosense",
  "version": "0.1.0",
  "private": true,
  "description": "eurosense.eu — static React site, migrated off Squarespace",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs && node scripts/check-media.mjs && node scripts/check-contrast.mjs",
    "check": "npm run validate && npm run typecheck && npm run build",
    "fonts": "node scripts/fonts.mjs",
    "optimise:media": "node scripts/optimise-media.mjs",
    "extract": "node scripts/extract.mjs",
    "extract:fetch": "node scripts/extract.mjs --stage=fetch",
    "extract:parse": "node scripts/extract.mjs --stage=parse",
    "extract:assets": "node scripts/extract.mjs --stage=assets",
    "dashboard:data": "node scripts/update-dashboard-data.mjs",
    "videos": "node scripts/fetch-videos.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "vendor:dashboard": "node scripts/vendor-dashboard-libs.mjs",
    "prebuild": "node scripts/vendor-dashboard-libs.mjs",
    "documents": "node scripts/fetch-documents.mjs",
    "measure:posts": "node scripts/measure-post-images.mjs",
    "content": "npm run extract:parse && npm run extract:assets && npm run documents && npm run measure:posts",
    "capture:dividers": "node scripts/capture-dividers.mjs"
  },
  "dependencies": {
    "marked": "^16.4.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@highcharts/map-collection": "^2.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.1.2",
    "echarts": "^5.5.1",
    "highcharts": "^11.4.8",
    "papaparse": "^5.3.2",
    "plotly.js-cartesian-dist-min": "^1.58.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.2",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  }
}
