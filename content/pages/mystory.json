              "align": "center"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"text-align:center; white-space:pre-wrap;\" class=\"sqsrte-large\">Encourage your <strong>friends and family</strong> to share their stories too - <strong>let's amplify all voices!</strong></p></div>",
