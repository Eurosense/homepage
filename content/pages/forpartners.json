        }
      },
      "blocks": [
        {
          "type": "richText",
          "html": "<div><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--lightAccent\"><strong>EuroSense Network</strong></span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">A Europe-wide citizen science network that wants to make the voices of European citizens heard by activists, policy makers and governments. </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">By understanding the experiences of citizens in public life, and the pulse of Europe, we will overcome polarisation and collectively tackle the challenges of our times such as climate change, inequality, immigration, democracy and security.</span></h3></div>",
          "layout": {
            "mobile": {
              "area": "1/2/10/10",
              "zIndex": 0,
              "justify": "flex-start",
              "align": "flex-start"
            },
