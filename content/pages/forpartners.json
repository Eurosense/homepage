      "blocks": [
        {
          "type": "richText",
          "html": "<div><h2 style=\"text-align:center; white-space:pre-wrap;\"><strong>Join the </strong><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"61e7c334-2f91-4771-97a8-69fbf7536c58\"><strong>EuroSense network </strong></span></h2><h2 style=\"text-align:center; white-space:pre-wrap;\"><strong>and make citizens voices </strong><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"465f2a70-f724-45ca-bdb6-e1e8e81e5e24\"><strong>heard </strong></span></h2><h2 style=\"text-align:center; white-space:pre-wrap;\"><strong>for </strong><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"20fe5c00-a507-43b7-8794-c11a68a294d6\"><strong>collective action</strong></span></h2></div>",
