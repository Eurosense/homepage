      "blocks": [
        {
          "type": "richText",
          "html": "<div><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">A Europe-wide citizen science network </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">making the </span><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"6e23a2b4-e491-48e7-954c-1f691a105f07\"><span class=\"sqsrte-text-color--accent\">voices of European citizens heard </span></span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">by activists, policy makers and governments. </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\"> By understanding the </span><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"a0c2af7c-ec53-4161-98f5-e163274f72f3\"><span class=\"sqsrte-text-color--accent\">experiences </span></span><span class=\"sqsrte-text-color--accent\">of citizens in public life, </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">we sense the pulse of Europe. </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">This informs us how to overcome polarization and</span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">collectively tackle the challenges of our times </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">such as climate change, inequality, immigration and security</span><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"b2d288fe-6cb1-4719-96de-d04ec7703c0f\"><span class=\"sqsrte-text-color--accent\">.</span></span></h3></div>",
          "layout": {
            "mobile": {
              "area": "1/2/3/10",
              "zIndex": 1,
