     if (parent) {\n            // 🔧 remove leftover spacing\n            parent.style.paddingBottom = '0';\n            parent.style.marginBottom  = '0';\n          }\n          clearInterval(timer);      // we're done\n        }\n        waited += INTERVAL;\n        if (waited >= MAX_TIME) clearInterval(timer);\n      };\n\n      const timer = setInterval(tidy, INTERVAL);\n    })();\n  </script>\n\n\n\n\n\n  \n  \n\n\n\n</div>\n\n<style class=\"transform-overrides-vars\">\n  \n</style>"
