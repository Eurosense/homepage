      "blocks": [
        {
          "type": "richText",
          "html": "<div><h1 style=\"white-space:pre-wrap;\">We believe in the <span class=\"sqsrte-text-color--custom\" style=\"color: #123BC8;\">power of dialogue</span> and <span class=\"sqsrte-text-color--custom\" style=\"color: #123BC8;\">empathy to bridge divides</span></h1></div>",
          "layout": {
            "mobile": {
              "area": "1/2/9/10",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "1/2/8/12",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">We engage with people from all walks of life by inviting them to share their real-life experiences. We empower them to make their voices heard in policy-making across Europe.</span></p></div>",
          "layout": {
            "mobile": {
              "area": "9/2/12/10",
              "zIndex": 2,
