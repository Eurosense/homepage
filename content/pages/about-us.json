      "blocks": [
        {
          "type": "richText",
          "html": "<div><p class=\"sqsrte-large\" style=\"white-space:pre-wrap;\">Our mission</p></div>",
          "layout": {
            "mobile": {
              "area": "3/2/5/10",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            },
