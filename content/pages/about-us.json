              "area": "5/4/6/10",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h2 style=\"white-space:pre-wrap;\">Each policy maker in the EU parliament should <span class=\"sqsrte-text-color--custom\" style=\"color: #123BC8;\">be able to hear your voice!</span></h2></div>",
          "layout": {
            "mobile": {
              "area": "5/2/12/10",
              "zIndex": 2,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
