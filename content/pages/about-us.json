              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h3 style=\"white-space:pre-wrap;\">Our Approach: Listening to Understand</h3></div>",
          "layout": {
            "mobile": {
              "area": "13/3/15/10",
              "zIndex": 6,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "6/15/7/23",
              "zIndex": 6,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\"><strong>01</strong></span></p></div>",
          "surface": {
            "background": "hsl(51.43 33.33% 95.88% / 1)",
            "radius": "999px 999px 999px 999px",
            "padding": "12% 12% 12% 12%"
          },
          "layout": {
            "mobile": {
              "area": "13/2/15/3",
              "zIndex": 14,
              "justify": "center",
              "align": "center"
            },
            "desktop": {
              "area": "6/14/8/15",
              "zIndex": 18,
              "justify": "center",
              "align": "center"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\">Instead of dismissing or protesting against differing views, we’re taking a different path. We step onto the streets, engaging with people from all walks of life, and invite them to share their stories</p></div>",
          "layout": {
            "mobile": {
              "area": "15/3/19/10",
              "zIndex": 7,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "7/15/9/23",
              "zIndex": 7,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h3 style=\"white-space:pre-wrap;\">The Power of Dialogue and Empathy</h3></div>",
          "layout": {
            "mobile": {
              "area": "20/3/22/10",
              "zIndex": 7,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "10/15/11/23",
              "zIndex": 8,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\"><strong>02</strong></span></p></div>",
          "surface": {
            "background": "hsl(51.43 33.33% 95.88% / 1)",
            "radius": "999px 999px 999px 999px",
            "padding": "12% 12% 12% 12%"
          },
          "layout": {
            "mobile": {
              "area": "20/2/22/3",
              "zIndex": 13,
              "justify": "center",
              "align": "center"
            },
            "desktop": {
              "area": "10/14/12/15",
              "zIndex": 17,
              "justify": "center",
              "align": "center"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\">We believe that dialogue and empathy are key to bridging divides. We’re not here to cancel or ignore concerns. Instead, we amplify voices.</p></div>",
          "layout": {
            "mobile": {
              "area": "22/3/25/10",
              "zIndex": 8,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "11/15/13/23",
              "zIndex": 9,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h3 style=\"white-space:pre-wrap;\">Our Goal: Solutions for Everyone</h3></div>",
          "layout": {
            "mobile": {
              "area": "26/3/27/10",
              "zIndex": 8,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "14/15/15/23",
              "zIndex": 10,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\">Our ultimate goal is to find common solutions that benefit all – from local communities to the broader European landscape.</p></div>",
          "layout": {
            "mobile": {
              "area": "27/3/30/10",
