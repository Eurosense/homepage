      "blocks": [
        {
          "type": "richText",
          "html": "<div><p class=\"sqsrte-large\" style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">Eurosense</span></p></div>",
          "layout": {
            "mobile": {
              "area": "1/2/3/10",
              "zIndex": 3,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "2/5/3/11",
              "zIndex": 3,
