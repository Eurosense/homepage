        {
          "type": "richText",
          "html": "<div><h4 style=\"white-space:pre-wrap;\">WEDECIDEAPP</h4><p style=\"white-space:pre-wrap;\"></p><p style=\"white-space:pre-wrap;\"></p><p style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">A digital civic app that helps people reflect on their concerns and measure their impact within their community. Using the science-backed EuroSense tool, it turns anonymous stories into real-time wellbeing insights and collective scorecards — transforming lived experience into measurable patterns that hold power accountable. Users can directly message their representatives, making citizen–leader relationships visible and impossible to ignore.<br><br>CONTACT: </span><a href=\"mailto:wedecide@pm.me\">wedecide@pm.me</a><br></p></div>",
          "layout": {
