            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h1 style=\"text-align:center; white-space:pre-wrap;\">We believe in </h1><h1 style=\"text-align:center; white-space:pre-wrap;\">the <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"51427442-f344-4059-9e12-2943f708d508\">power of dialogue </span></h1><h1 style=\"text-align:center; white-space:pre-wrap;\">and <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"7b3dc6b4-ee28-480d-a2b1-67296d766ec2\">empathy</span> </h1><h1 style=\"text-align:center; white-space:pre-wrap;\">to <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"48ad3fff-ce88-4c67-8aeb-842ef5980de5\">bridge </span>divides.</h1></div>",
          "layout": {
            "mobile": {
              "area": "47/2/57/10",
              "zIndex": 10,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "1/2/11/26",
              "zIndex": 10,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-color--white\">We engage with people from all walks of life by inviting them to share their real-life experiences. We empower them to make their voices heard in policy-making across Europe.</span></h3></div>",
          "layout": {
            "mobile": {
              "area": "58/2/65/10",
              "zIndex": 11,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "11/4/15/24",
              "zIndex": 11,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        }
      ]
