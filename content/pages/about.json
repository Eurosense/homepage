            },
            "desktop": {
              "area": "25/3/29/6",
              "zIndex": 5,
              "justify": "center",
              "align": "center"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\">“I am happy that in my area some of the streets are blocked for cars and turned to bicycle roads. It is more fun to pass there with my kids.”</p></div>",
          "layout": {
            "mobile": {
              "area": "37/2/40/10",
              "zIndex": 7,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "29/3/32/9",
              "zIndex": 7,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "image",
          "src": "/media/6-2a5ff61b.png",
          "alt": "",
          "width": 1080,
          "height": 1080,
          "caption": "",
          "layout": {
            "mobile": {
              "area": "39/2/43/4",
