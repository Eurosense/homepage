      "blocks": [
        {
          "type": "richText",
          "html": "<div><h3 style=\"text-align:center; white-space:pre-wrap;\">Instead of <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"3ce6f510-82e0-4353-bc38-d9179cc3c0ee\">ignoring</span> people </h3><h3 style=\"text-align:center; white-space:pre-wrap;\">who have differing views</h3><h3 style=\"text-align:center; white-space:pre-wrap;\">or telling them <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"1119803b-c2e8-461d-a843-716c34cefd0e\">what to think </span></h3><h3 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"abae320e-0a66-4af0-b7b6-24ac1c685adc\">we are listening *. </span></h3></div>",
