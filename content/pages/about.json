            "desktop": {
              "area": "16/6/20/9",
              "zIndex": 4,
              "justify": "center",
              "align": "center"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\">“Friends of my father are concerned about migrants taking away their workplaces.”</p></div>",
          "layout": {
            "mobile": {
              "area": "43/2/45/10",
              "zIndex": 8,
              "justify": "flex-start",
