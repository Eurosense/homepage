          "rowScale": 0.0215
        }
      },
      "blocks": [
        {
          "type": "richText",
          "html": "<div><h2 style=\"text-align:center; white-space:pre-wrap;\"><strong>The project envisions a society where </strong><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"d3066845-d886-4461-9851-b979e11813be\"><strong>citizens trust their own capacity to impact politics </strong></span><strong>and actively participate in shaping their communities and societies.</strong></h2></div>",
          "layout": {
            "mobile": {
              "area": "1/2/3/10",
              "zIndex": 2,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "2/2/17/8",
              "zIndex": 2,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        },
        {
          "type": "richText",
          "html": "<div><h4 style=\"white-space:pre-wrap;\">The <strong>long-term vision </strong>of the project is to create a more <strong>inclusive and democratic society </strong>in Europe by empowering citizens to actively participate in political discussion and decision-making processes.&nbsp;</h4><h4 style=\"white-space:pre-wrap;\"><strong>The project aims</strong> to foster a culture of citizen engagement and sense making, where citizens' voices are heard and valued in policy and decision-making at local, national, and European levels. ​&nbsp;</h4><h4 style=\"white-space:pre-wrap;\"><strong>By leveraging the innovative SenseMakerⓇ</strong> software and a <strong>decentralised citizen sensor network</strong>, the project seeks to <strong>enable citizens to make sense of complex societal challenges</strong> and contribute to finding solutions. ​&nbsp;</h4><h4 style=\"white-space:pre-wrap;\"><strong>The long-term impact </strong>of the project is envisioned to be a political landscape where citizens' voices are given importance, leading to more responsive and effective political responses that serve the common good. This vision includes that elected officials from the European Parliament to local governments recognise the importance of citizens' voices and actively incorporate them in all phases of decision-making processes. ​&nbsp;</h4><h4 style=\"white-space:pre-wrap;\">Additionally, the project aims <strong>to inspire and influence other political parties</strong> and decision-makers to adopt similar approaches, making \"sensemaking\" an <strong>integral part of a European democratic culture. ​&nbsp;</strong><br></h4></div>",
          "layout": {
            "mobile": {
              "area": "3/2/5/10",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "1/9/16/26",
              "zIndex": 1,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
        }
      ]
    },
