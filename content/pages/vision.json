        {
          "type": "richText",
          "html": "<div><div class=\"sqsrte-scaled-text-container\"><span class=\"sqsrte-scaled-text\"><h1 style=\"text-align:center; white-space:pre-wrap;\"><span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"dae1c864-f856-41ad-ace3-8ec7d565d6a6\">Our Vision&nbsp;</span> </h1></span></div></div>",
