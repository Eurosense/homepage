        {
          "type": "embed",
          "html": "<div class=\"sqs-code-container\" data-localized=\"{&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Please view the page after logging out for accurate rendering.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Safe Preview&quot;,&quot;globalSafeMode&quot;:&quot;Embedded Code: This block contains embedded code that has been disabled.&quot;,&quot;scriptDisabled&quot;:&quot;Script Disabled&quot;}\">\n  \n    \n\n  \n    <meta charset=\"UTF-8\">\n    <title>Map with Growing Bubbles and Registration</title>\n    <style>\n      html,\n      body {\n        margin: 0;\n        padding: 0;\n        width: 100%;\n        height: 100vh;\n        font-family: sans-serif;\n        position: relative;\n      }\n      #container {\n        width: 100vw;\n        height: 100vh;\n        position: relative;\n        box-sizing: border-box;\n        cursor: pointer;\n      }\n    </style>\n    <script src=\"https://code.highcharts.com/maps/highmaps.js\"></script>\n  \n  \n    <div id=\"container\"></div>\n    <script>\n      const userData = [\n        { Name: \"Ethan\", Surname: \"Smith\", Country: \"Czech Republic\" },\n        { Name: \"David\", Surname: \"Johnson\", Country: \"Poland\" },\n        { Name: \"Liam\", Surname: \"Brown\", Country: \"France\" },\n        { Name: \"Samuel\", Surname: \"Taylor\", Country: \"France\" },\n        { Name: \"Emma\", Surname: \"Anderson\", Country: \"Switzerland\" },\n        { Name: \"James\", Surname: \"Thomas\", Country: \"Spain\" },\n        { Name: \"Mia\", Surname: \"Jackson\", Country: \"Germany\" },\n        { Name: \"Evelyn\", Surname: \"White\", Country: \"Switzerland\" },\n        { Name: \"John\", Surname: \"Harris\", Country: \"Portugal\" },\n        { Name: \"Anne\", Surname: \"Martin\", Country: \"Spain\" },\n        { Name: \"Lucas\", Surname: \"Thompson\", Country: \"France\" },\n        { Name: \"Mia\", Surname: \"Garcia\", Country: \"Norway\" },\n        { Name: \"Charlotte\", Surname: \"Martinez\", Country: \"Netherlands\" },\n        { Name: \"Samuel\", Surname: \"Robinson\", Country: \"Germany\" },\n        { Name: \"Sophia\", Surname: \"Clark\", Country: \"Netherlands\" },\n        { Name: \"Joseph\", Surname: \"Rodriguez\", Country: \"Greece\" },\n        { Name: \"Amelia\", Surname: \"Lewis\", Country: \"Belgium\" },\n        { Name: \"Harper\", Surname: \"Walker\", Country: \"Switzerland\" },\n        { Name: \"Anne\", Surname: \"Perez\", Country: \"Austria\" },\n        { Name: \"Ava\", Surname: \"Hall\", Country: \"Germany\" },\n        { Name: \"Henry\", Surname: \"Allen\", Country: \"Belgium\" },\n        { Name: \"Liam\", Surname: \"Young\", Country: \"Czech Republic\" },\n        { Name: \"James\", Surname: \"King\", Country: \"Italy\" },\n        { Name: \"Charlotte\", Surname: \"Scott\", Country: \"Greece\" },\n        { Name: \"Anne\", Surname: \"Adams\", Country: \"Germany\" },\n        { Name: \"Ethan\", Surname: \"Baker\", Country: \"Greece\" },\n        { Name: \"Charlotte\", Surname: \"Gonzalez\", Country: \"Belgium\" },\n        { Name: \"Anne\", Surname: \"Nelson\", Country: \"Switzerland\" },\n        { Name: \"Isabella\", Surname: \"Carter\", Country: \"Poland\" },\n        { Name: \"Evelyn\", Surname: \"Mitchell\", Country: \"Poland\" },\n      ];\n\n      const capitals = {\n        Albania: { lat: 41.3275, lon: 19.8189 },\n        Andorra: { lat: 42.5063, lon: 1.5218 },\n        Austria: { lat: 48.2082, lon: 16.3738 },\n        Belarus: { lat: 53.9, lon: 27.5667 },\n        Belgium: { lat: 50.8503, lon: 4.3517 },\n        \"Bosnia and Herzegovina\": { lat: 43.8563, lon: 18.4131 },\n        Bulgaria: { lat: 42.6977, lon: 23.3219 },\n        Croatia: { lat: 45.815, lon: 15.9819 },\n        Cyprus: { lat: 35.1667, lon: 33.3667 },\n        \"Czech Republic\": { lat: 50.0878, lon: 14.4205 },\n        Denmark: { lat: 55.6761, lon: 12.5683 },\n        Estonia: { lat: 59.437, lon: 24.7536 },\n        Finland: { lat: 60.1699, lon: 24.9384 },\n        France: { lat: 48.8566, lon: 2.3522 },\n        Germany: { lat: 52.52, lon: 13.405 },\n        Greece: { lat: 37.9838, lon: 23.7275 },\n        Hungary: { lat: 47.4979, lon: 19.0402 },\n        Iceland: { lat: 64.1466, lon: -21.9426 },\n        Ireland: { lat: 53.3498, lon: -6.2603 },\n        Italy: { lat: 41.9028, lon: 12.4964 },\n        Kosovo: { lat: 42.6629, lon: 21.1655 },\n        Latvia: { lat: 56.9496, lon: 24.1052 },\n        Liechtenstein: { lat: 47.1415, lon: 9.5215 },\n        Lithuania: { lat: 54.6872, lon: 25.2797 },\n        Luxembourg: { lat: 49.6116, lon: 6.1319 },\n        Malta: { lat: 35.8978, lon: 14.5146 },\n        Moldova: { lat: 47.0105, lon: 28.8638 },\n        Monaco: { lat: 43.7384, lon: 7.4246 },\n        Montenegro: { lat: 42.4304, lon: 19.2594 },\n        Netherlands: { lat: 52.3676, lon: 4.9041 },\n        \"North Macedonia\": { lat: 41.9973, lon: 21.428 },\n        Norway: { lat: 59.9139, lon: 10.7522 },\n        Poland: { lat: 52.2297, lon: 21.0122 },\n        Portugal: { lat: 38.7223, lon: -9.1393 },\n        Romania: { lat: 44.4268, lon: 26.1025 },\n        \"San Marino\": { lat: 43.9352, lon: 12.4471 },\n        Serbia: { lat: 44.7866, lon: 20.4489 },\n        Slovakia: { lat: 48.1486, lon: 17.1077 },\n        Slovenia: { lat: 46.0569, lon: 14.5058 },\n        Spain: { lat: 40.4168, lon: -3.7038 },\n        Sweden: { lat: 59.3293, lon: 18.0686 },\n        Switzerland: { lat: 46.948, lon: 7.4474 },\n        Turkey: { lat: 39.9208, lon: 32.8541 },\n        Ukraine: { lat: 50.4501, lon: 30.5234 },\n        \"United Kingdom\": { lat: 51.5074, lon: -0.1278 },\n        \"Vatican City\": { lat: 41.9022, lon: 12.4539 },\n        Russia: { lat: 55.7558, lon: 37.6173 },\n      };\n\n      const usersByCountry = userData.reduce((acc, user) => {\n        if (!acc[user.Country]) {\n          acc[user.Country] = 0;\n        }\n        acc[user.Country]++;\n        return acc;\n      }, {});\n\n      const points = Object.keys(capitals).map((country) => {\n        const coords = capitals[country];\n        const count = usersByCountry[country] || 0;\n        return {\n          name: country,\n          lat: coords.lat,\n          lon: coords.lon,\n          count,\n        };\n      });\n\n      (async () => {\n        try {\n          const response = await fetch(\n            \"https://code.highcharts.com/mapdata/custom/europe.topo.json\"\n          );\n          const topology = await response.json();\n\n          Highcharts.mapChart(\"container\", {\n            chart: {\n              map: topology,\n              margin: 1,\n              events: {\n                click: function () {},\n              },\n            },\n            title: { text: \"\" },\n            mapNavigation: {\n              enabled: true,\n              buttonOptions: { alignTo: \"spacingBox\", verticalAlign: \"bottom\" },\n            },\n            mapView: { padding: [0, 0, 85, 0] },\n            legend: { enabled: false },\n            tooltip: {\n              enabled: true,\n              formatter: function () {\n                return (\n                  `<b>${this.point.name}</b><br>` + `Users: ${this.point.count}`\n                );\n              },\n            },\n            exporting: { enabled: false },\n            series: [\n              {\n                allAreas: true,\n                name: \"Countries\",\n                states: { inactive: { opacity: 1 } },\n                dataLabels: { enabled: false },\n                enableMouseTracking: false,\n                color: \"#E0E0E0\",\n              },\n              {\n                type: \"mappoint\",\n                name: \"Users\",\n                data: points.map((point) => ({\n                  name: point.name,\n                  lat: point.lat,\n                  lon: point.lon,\n                  count: point.count,\n                  marker: {\n                    symbol: \"circle\",\n                    radius: point.count > 0 ? 4 + point.count * 2 : 4,\n                    fillColor: \"#f45b5b\",\n                    lineWidth: 2,\n                    lineColor: \"#ffffff\",\n                  },\n                  events: {\n                    click: function () {\n                      window.open(\"https://example.com/registration\", \"_blank\");\n                    },\n                  },\n                })),\n              },\n            ],\n          });\n        } catch (error) {\n          console.error(\"Error loading map topology:\", error);\n        }\n      })();\n    </script>\n  \n\n\n  \n  \n\n\n\n</div>\n\n<style class=\"transform-overrides-vars\">\n  \n</style>",
