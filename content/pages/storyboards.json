        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\"><a target=\"_blank\" href=\"https://drive.usercontent.google.com/download?id=1pXEW9o1rtG2p-87F5uCmWoGxgNwlnlrL\"><span class=\"sqsrte-text-color--darkAccent\"><strong>Storyboard of Charge DI stories.</strong></span><span class=\"sqsrte-text-color--accent\"><strong>&nbsp;&nbsp;</strong>Download</span></a></p></div>",
