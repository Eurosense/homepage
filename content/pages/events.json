        {
          "type": "richText",
          "html": "<div><p style=\"white-space:pre-wrap;\"><strong>Wednesday, 9 December 2026<br>18:30–20:00 CET · Online · Free</strong></p></div>",
          "layout": {
            "mobile": { "area": "42/2/45/10", "zIndex": 9, "justify": "flex-start", "align": "flex-start" },
            "desktop": { "area": "18/14/20/23", "zIndex": 9, "justify": "flex-start", "align": "flex-start" }
