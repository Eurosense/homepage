        {
          "type": "richText",
          "html": "<div><h3 style=\"white-space:pre-wrap;\">We use <em>SenseMaker</em>, an innovative <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"7ba62886-784a-45e9-8bf0-d6ff9cbed516\">online tool</span>, to gather <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"1bb4f993-f61c-4f1b-a65d-4024e949864e\">real-life stories</span> from various communities. </h3><h3 style=\"white-space:pre-wrap;\">Designed by <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"97cfd47a-fa00-4861-9e53-c038dcb68d2b\">experts</span>, this tool lets individuals share and <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"6d5a1d2a-d92b-4888-9020-a12c21083048\">interpret </span>their own experiences.</h3><h3 style=\"white-space:pre-wrap;\">Activists and policymakers can use it to identify <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"a44be183-02ef-4466-ae64-2a8af19429d7\">patterns</span>, <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"f06c805f-22dc-4cb2-b6e4-9ede664cb662\">emerging issues</span>, and guide <span class=\"sqsrte-text-highlight\" data-text-attribute-id=\"59394c66-1683-49dd-a449-a6e5b86a5b93\">positive change </span>in society.</h3></div>",
          "layout": {
            "mobile": {
              "area": "12/2/24/10",
              "zIndex": 4,
              "justify": "flex-start",
              "align": "flex-start"
            },
            "desktop": {
              "area": "4/9/13/24",
              "zIndex": 4,
              "justify": "flex-start",
              "align": "flex-start"
            }
          }
